# Whatsapp notification.
# true|false
WA_NOTIFICATION=false
# Provider: Auto|Fonnte|OpenWA|ApiMe|EvolutionAPI|Wuzapi|Wwebjs|Waxum
#   Auto         -> acak, hanya dari provider yang WHATSAPP_TOKEN_<Provider>-nya diisi
#   Fonnte       -> layanan berbayar, ambil token di https://md.fonnte.com/
#   OpenWA       -> self-hosted, https://github.com/rmyndharis/OpenWA
#   ApiMe        -> self-hosted, https://github.com/open-apime/apime
#   EvolutionAPI -> self-hosted, https://github.com/evolution-foundation/evolution-api
#   Wuzapi       -> self-hosted, https://github.com/asternic/wuzapi
#   Wwebjs       -> self-hosted, https://github.com/avoylenko/wwebjs-api
#   Waxum        -> self-hosted, https://github.com/imtaqin/waxum
WHATSAPP_PROVIDER=Auto
WHATSAPP_TOKEN_Wuzapi=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_ApiMe=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_Fonnte=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_OpenWA=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_Wwebjs=XXXXXXXXXXXXXXXXX
WHATSAPP_TOKEN_Waxum=XXXXXXXXXXXXXXXXX
# Token umum, dipakai HANYA kalau WHATSAPP_TOKEN_<Provider> di atas kosong.
# Mode Auto TIDAK menghitung kunci ini -- supaya Auto bisa memilih gateway,
# isi token per-provider di atas. Kunci ini untuk kasus satu gateway tetap
# yang tokennya tidak mau dipecah per nama.
WHATSAPP_TOKEN=
# Base URL gateway, khusus provider self-hosted.
# Pakai kunci per-provider: itulah yang memungkinkan beberapa gateway
# dikonfigurasi bersamaan. Kalau kunci per-provider kosong, barulah
# WHATSAPP_URL dipakai; kalau itu pun kosong, tiap provider memakai bawaannya.
#   OpenWA       -> https://openwa.whatsapp.com (token = API key, header X-API-Key)
#   ApiMe        -> https://api-me.whatsapp.com (token = instance token, header Bearer)
#   EvolutionAPI -> https://evolution-api.whatsapp.com (token = API key global atau token instance, header apikey)
#   Wuzapi       -> https://wuzapi.whatsapp.com (token = token user, header Token)
#   Wwebjs       -> https://wwebjs.whatsapp.com (token = API key global, header x-api-key; opsional)
#   Waxum        -> https://waxum.whatsapp.com (token = SUPERADMIN_TOKEN, header Authorization: Bearer)
WHATSAPP_URL_OpenWA=
WHATSAPP_URL_ApiMe=
WHATSAPP_URL_EvolutionAPI=
WHATSAPP_URL_Wuzapi=
WHATSAPP_URL_Wwebjs=
WHATSAPP_URL_Waxum=
# Fonnte tidak self-hosted: endpointnya tetap. Kunci ini hanya perlu kalau
# pengiriman harus lewat proxy atau endpoint lain, jadi sengaja dikomentari.
# WHATSAPP_URL_Fonnte=
# Cadangan umum, dipakai HANYA kalau kunci per-provider di atas kosong.
# Jangan diisi kalau tiap gateway sudah punya kunci sendiri: nilai ini
# berlaku untuk provider apa pun yang sedang aktif.
WHATSAPP_URL=
# Khusus Fonnte Device API (add-device, get-devices, update, delete).
# Ini BUKAN token perangkat: token perangkat dipakai mengirim pesan dan
# ditolak di Device API dengan "unknown user". Ambil di menu setting Fonnte.
WHATSAPP_ACCOUNT_TOKEN=
# Khusus OpenWA, Wwebjs, dan Waxum: id session yang sudah di-start dan scan QR.
# Dipakai juga sebagai id bawaan oleh createSession() dan checkSession().
#   OpenWA -> id session bebas
#   Wwebjs -> hanya huruf, angka, garis bawah, dan tanda minus
#   Waxum  -> id apa pun; kalau dikosongkan, waxum membuat id acak sendiri
#
# Tiap gateway punya kuncinya SENDIRI. Isi kunci per-provider di bawah, supaya
# tiga gateway bisa memakai nama session yang berbeda-beda dalam satu aplikasi
# — dengan satu WHATSAPP_SESSION bersama, nama yang ditujukan untuk OpenWA ikut
# terpakai Wwebjs dan Waxum. Kunci per-provider menang atas kunci bersama.
WHATSAPP_SESSION_OpenWA=
WHATSAPP_SESSION_Wwebjs=
WHATSAPP_SESSION_Waxum=
# Daftar sesi jamak: dipisah koma. Hanya untuk gateway yang mengelola beberapa
# sesi sekaligus — mis. satu server OpenWA dengan sesi untuk tiga departemen.
# Kunci tunggal di atas menentukan sesi AKTIF; kunci jamak di bawah mendaftar
# semuanya yang dikenal aplikasi. Kalau kunci tunggal tidak diisi, yang pertama
# dalam daftar ini menjadi sesi aktif bawaan.
# WHATSAPP_SESSIONS_OpenWA=sales,support,billing
# WHATSAPP_SESSIONS_Wwebjs=sales,support
# WHATSAPP_SESSIONS_Waxum=sales,support,billing
# Cadangan bersama, dipakai HANYA kalau kunci per-provider di atas kosong.
# Jangan diisi kalau tiap gateway sudah punya session sendiri: nilai ini
# berlaku untuk gateway mana pun yang sedang aktif.
WHATSAPP_SESSION=
# Khusus ApiMe (UUID instance) dan EvolutionAPI (nama instance).
# Wuzapi tidak memakainya: tokennya sendiri yang menentukan sesi.
# Dipakai juga sebagai nama bawaan oleh createSession() dan checkSession().
#
# Seperti session, kunci per-provider didahulukan supaya ApiMe dan EvolutionAPI
# bisa memakai instance yang berbeda dalam satu aplikasi.
WHATSAPP_INSTANCE_ApiMe=
WHATSAPP_INSTANCE_EvolutionAPI=
# Cadangan bersama, dipakai HANYA kalau kunci per-provider di atas kosong.
WHATSAPP_INSTANCE=
# Batas waktu request ke gateway, detik (1-60, default 10).
# Halaman scan absen menunggu selama ini, jadi jangan terlalu besar.
WHATSAPP_TIMEOUT=10
# Jeda antar pesan saat mengirim beruntun, supaya polanya tidak seragam dan
# mudah dikenali sebagai robot. Tiga hal diatur di sini:
#
#   WHATSAPP_PACING_CYCLE     daftar jeda tetap yang dipakai BERGILIRAN, detik.
#                             "0,30" -> pesan ke-1 tanpa jeda, ke-2 jeda 30
#                             detik, ke-3 tanpa jeda, dan seterusnya.
#   WHATSAPP_PACING_INTERVAL  jitter acak yang DITAMBAHKAN ke tiap jeda siklus,
#                             detik. "20-30" -> tiap jeda ditambah 20-30 detik
#                             acak; angka tunggal ("25") berarti tetap.
#   WHATSAPP_PACING_LONG_*    pesan yang isinya panjang ditunggu lebih lama,
#                             karena mengirim teks panjang beruntun lebih
#                             mencurigakan daripada mengirim pesan pendek.
#                             _CHARS  = ambangnya, karakter (default 300).
#                             _FACTOR = berapa kali jedanya dilipatkan
#                                       (default 3).
#
# Jadi jeda sebelum pesan ke-i = (siklus[i % jumlah siklus] + jitter) x pengali.
# Dengan contoh di bawah: pesan pendek berurutan 20-30, 50-60, 20-30, ... detik,
# sedangkan pesan 300 karakter ke atas 60-90, 150-180, 60-90, ... detik.
#
# Sengaja dikomentari: bawaannya MATI. Mengirim banyak pesan akan menahan
# proses pemanggil selama total jeda itu, jadi nyalakan dengan sadar.
# WHATSAPP_PACING_CYCLE=0,30
# WHATSAPP_PACING_INTERVAL=20-30
# WHATSAPP_PACING_LONG_CHARS=300
# WHATSAPP_PACING_LONG_FACTOR=3
# Indikator "sedang mengetik" yang dimunculkan SDK sendiri sebelum mengirim.
# Kalau menyala, tiap pesan didahului satu request presence, lalu SDK menunggu
# selama indikatornya tampil sebelum pesannya dikirim. Lamanya mengikuti
# panjang pesan:
#
#   lama = panjang pesan / WHATSAPP_TYPING_SPEED, dijepit antara MIN dan MAX
#
# Dengan contoh di bawah, 10 karakter jadi 2 detik, 60 karakter 4 detik,
# 150 karakter 10 detik, dan 300 karakter ke atas berhenti di 20 detik.
#
#   WHATSAPP_TYPING        saklar on/off. Hanya kunci INI yang menyalakan;
#                          mengisi SPEED/MIN/MAX saja tidak mengubah apa pun.
#   WHATSAPP_TYPING_SPEED  kecepatan ketik, karakter per detik (default 15).
#   WHATSAPP_TYPING_MIN    lama tampil paling singkat, detik (default 2).
#   WHATSAPP_TYPING_MAX    lama tampil paling lama, detik (default 20).
#
# Sengaja dikomentari: bawaannya MATI. Fitur ini menambah satu request ke jalur
# kirim dan menahan proses pemanggil selama durasinya, jadi nyalakan dengan
# sadar. Untuk satu panggilan saja, sertakan kunci `typing` di dalam array
# pesan -- itu sudah cukup menyalakannya tanpa kunci ini.
# WHATSAPP_TYPING=1
# WHATSAPP_TYPING_SPEED=15
# WHATSAPP_TYPING_MIN=2
# WHATSAPP_TYPING_MAX=20
#
# Pagar laju (warmup): batasi berapa banyak pesan per rentang waktu, supaya
# akun baru tidak langsung menghajar banyak nomor dalam satu tarikan napas.
#
#   WHATSAPP_THROTTLE_MAX     jumlah pesan yang boleh dikirim per jendela.
#   WHATSAPP_THROTTLE_WINDOW  panjang satu jendela, dalam detik.
#
# Aturannya berbasis posisi: pesan ke-1..MAX masuk jendela pertama (tanpa
# jeda), MAX+1..2xMAX menunggu satu jendela penuh, dan seterusnya. Angka jeda
# yang dihasilkan DIBANDINGKAN dengan jeda pacing dan diambil yang terbesar --
# keduanya bisa dipakai bersamaan tanpa jeda menumpuk dua kali.
#
# Sengaja dikomentari: bawaannya MATI. Seperti pacing, ia menahan proses
# pemanggil, jadi nyalakan dengan sadar. Contoh di bawah: paling banyak 20
# pesan per 60 detik.
# WHATSAPP_THROTTLE_MAX=20
# WHATSAPP_THROTTLE_WINDOW=60
#
# Percobaan ulang otomatis saat gateway menolak karena batas laju (HTTP 429)
# atau sesi belum siap (HTTP 503).
#
#   WHATSAPP_RETRIES  berapa kali SDK boleh mencoba ulang. Bawaannya 0.
#
# Percobaan ulang hanya dilakukan bila gateway menyebutkan header
# `Retry-After`, dan SDK menunggu selama angka itu -- bukan menebak sendiri.
# Tanpa `Retry-After`, exception langsung dilempar supaya pemanggil yang
# mengatur jadwalnya; menebak terlalu cepat hanya menabrak dinding yang sama.
# Status lain (401, 403, 404, 409) tidak pernah diulang karena tidak akan
# sembuh. Mengulang berarti menahan proses pemanggil, jadi bawaannya MATI.
# WHATSAPP_RETRIES=2
